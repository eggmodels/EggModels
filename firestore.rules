rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read tennis_odds/current
    match /tennis_odds/{document=**} {
      allow read;
    }

    // Allow anyone to read nfl_2026/current
    match /nfl_2026/{document=**} {
      allow read;
    }

    // Software-factory run records (see software-factory/README.md). Public
    // read so the /factory dashboard can render client-side, like every
    // other collection here; writes only ever come from the factory VM's
    // service account via the Admin SDK, which bypasses these rules, so
    // client writes are denied.
    match /factory_runs/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
